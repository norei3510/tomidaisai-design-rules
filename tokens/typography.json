{
  "$description": "文字トークン。値の正はこのファイル。使い分けは guidelines/FOUNDATIONS.md §3。",
  "font-family": {
    "body": { "$type": "fontFamily", "$value": ["Noto Sans JP", "Hiragino Sans", "Yu Gothic", "Meiryo", "sans-serif"], "$description": "全ページ共通の本文・UI書体。フォント本体は本リポジトリに含めない" }
  },
  "font-size": {
    "xs": { "$type": "dimension", "$value": "12px", "$description": "注記・ナビラベル・チップ。下限" },
    "sm": { "$type": "dimension", "$value": "14px", "$description": "補足文・カード内の説明・ラベル" },
    "body": { "$type": "dimension", "$value": "16px", "$description": "本文・ボタン・入力" },
    "lg": { "$type": "dimension", "$value": "18px", "$description": "小見出し・カード見出し・大きい操作" },
    "xl": { "$type": "dimension", "$value": "22px", "$description": "画面見出し（h1）" },
    "2xl": { "$type": "dimension", "$value": "26px", "$description": "大見出し" },
    "display": { "$type": "dimension", "$value": "34px", "$description": "スタンプ・結果表示など1画面1か所" }
  },
  "font-weight": {
    "regular": { "$type": "fontWeight", "$value": 400, "$description": "本文" },
    "bold": { "$type": "fontWeight", "$value": 700, "$description": "見出し・ボタン・ラベル・強調" },
    "heavy": { "$type": "fontWeight", "$value": 800, "$description": "アイブロウ（英字の小見出し）" },
    "black": { "$type": "fontWeight", "$value": 900, "$description": "display サイズのみ" }
  },
  "line-height": {
    "body": { "$type": "number", "$value": 1.7, "$description": "本文・吹き出し・ボタン" },
    "compact": { "$type": "number", "$value": 1.5, "$description": "補助文・入力の説明・大きいボタンラベル" },
    "heading": { "$type": "number", "$value": 1.3, "$description": "見出し・場所名" },
    "tight": { "$type": "number", "$value": 1, "$description": "1行固定のタグ・ナビラベル" }
  },
  "letter-spacing": {
    "default": { "$type": "dimension", "$value": "0", "$description": "本文" },
    "eyebrow": { "$type": "dimension", "$value": "0.15em", "$description": "アイブロウ" },
    "code": { "$type": "dimension", "$value": "0.08em", "$description": "コード入力欄" }
  }
}
