{
  "$description": "色トークン。primitive（ブランド・素の色）と semantic（用途）の2層。値の正はこのファイル。参照ルールは guidelines/TOKEN_GUIDE.md。出典: unifes26-vp front/src/design-tokens.css（2026-10-21）",
  "primitive": {
    "blue-100": { "$type": "color", "$value": "#C8E7FF", "$description": "ブランド背景（CSS --bg）" },
    "blue-50": { "$type": "color", "$value": "#EAF5FF", "$description": "淡い青の面（CSS --surface-soft）" },
    "blue-200": { "$type": "color", "$value": "#C6DFEF", "$description": "枠線（CSS --border）" },
    "blue-500": { "$type": "color", "$value": "#2082C3", "$description": "ブランドの青。図形・枠用。白地の本文には使わない（4.2:1）（CSS --main）" },
    "blue-700": { "$type": "color", "$value": "#18679D", "$description": "白文字を載せる青・青い文字（CSS --main-dark）" },
    "blue-800": { "$type": "color", "$value": "#125580", "$description": "青い操作の押下（CSS --main-pressed）" },
    "orange-50": { "$type": "color", "$value": "#FFF1E5", "$description": "淡い橙の面（CSS --surface-warm）" },
    "orange-500": { "$type": "color", "$value": "#F26A00", "$description": "ブランドの橙。図形・装飾線用。文字や白文字の下地には使わない（3.1:1）（CSS --accent）" },
    "orange-700": { "$type": "color", "$value": "#B34A00", "$description": "白文字を載せる橙・橙の文字（CSS --accent-text）" },
    "orange-800": { "$type": "color", "$value": "#903C00", "$description": "橙の操作の押下・hover（CSS --accent-dark）" },
    "navy-900": { "$type": "color", "$value": "#173A52", "$description": "本文（CSS --ink）" },
    "navy-500": { "$type": "color", "$value": "#5B7A93", "$description": "補足文。白い面の上でのみ使う（CSS --muted）" },
    "red-500": { "$type": "color", "$value": "#D93636", "$description": "エラーの図形・枠（CSS --danger）" },
    "red-700": { "$type": "color", "$value": "#A42A23", "$description": "エラー文字。【暫定】コード独自値（location-screen.css / qr-scanner.css）" },
    "yellow-300": { "$type": "color", "$value": "#FFD166", "$description": "達成済みの印（CSS --progress-done）" },
    "white": { "$type": "color", "$value": "#FFFFFF", "$description": "白い面（CSS --white）" },
    "overlay": { "$type": "color", "$value": "rgba(23, 58, 82, 0.45)", "$description": "モーダル背面（CSS --overlay）" }
  },
  "semantic": {
    "bg-page": { "$type": "color", "$value": "{primitive.blue-100}", "$description": "ページ全体の下地" },
    "bg-surface": { "$type": "color", "$value": "{primitive.white}", "$description": "カード・吹き出し・入力・ナビの面" },
    "bg-surface-soft": { "$type": "color", "$value": "{primitive.blue-50}", "$description": "カード内の補助領域・空状態" },
    "bg-surface-warm": { "$type": "color", "$value": "{primitive.orange-50}", "$description": "選択中ナビのピル・橙系の強調面" },
    "bg-header": { "$type": "color", "$value": "{primitive.blue-700}", "$description": "共通ヘッダー" },
    "bg-overlay": { "$type": "color", "$value": "{primitive.overlay}", "$description": "モーダル・ダイアログ背面" },
    "text-primary": { "$type": "color", "$value": "{primitive.navy-900}", "$description": "本文・見出し" },
    "text-secondary": { "$type": "color", "$value": "{primitive.navy-500}", "$description": "補足文。白い面の上のみ・12px以上" },
    "text-on-fill": { "$type": "color", "$value": "{primitive.white}", "$description": "青・橙の塗りの上の文字" },
    "text-link": { "$type": "color", "$value": "{primitive.blue-700}", "$description": "リンク・青い文字・小見出し" },
    "text-accent": { "$type": "color", "$value": "{primitive.orange-700}", "$description": "橙の文字（選択中ナビ、強調ラベル）" },
    "text-danger": { "$type": "color", "$value": "{primitive.red-700}", "$description": "エラー文" },
    "action-primary": { "$type": "color", "$value": "{primitive.orange-700}", "$description": "主要操作ボタンの塗り" },
    "action-primary-pressed": { "$type": "color", "$value": "{primitive.orange-800}", "$description": "主要操作の押下・hover" },
    "action-secondary": { "$type": "color", "$value": "{primitive.blue-700}", "$description": "副操作ボタンの塗り・枠線ボタンの枠と文字" },
    "action-secondary-pressed": { "$type": "color", "$value": "{primitive.blue-800}", "$description": "副操作の押下・hover" },
    "border-default": { "$type": "color", "$value": "{primitive.blue-200}", "$description": "区切り線・カード枠" },
    "border-input": { "$type": "color", "$value": "{primitive.blue-500}", "$description": "入力欄の枠（2px）" },
    "border-danger": { "$type": "color", "$value": "{primitive.red-500}", "$description": "エラー状態の入力欄の枠" },
    "focus-ring": { "$type": "color", "$value": "{primitive.navy-900}", "$description": "キーボードフォーカス枠（3px）" },
    "graphic-accent": { "$type": "color", "$value": "{primitive.orange-500}", "$description": "装飾線・スキャン線・注意の下線など、文字以外の橙" },
    "graphic-main": { "$type": "color", "$value": "{primitive.blue-500}", "$description": "図形・アイコン・枠など、文字以外の青" },
    "status-done": { "$type": "color", "$value": "{primitive.yellow-300}", "$description": "達成済みの印（形状の変化と併用）" }
  }
}
